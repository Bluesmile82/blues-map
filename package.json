{
  "name": "blues-genealogy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backup": "node -e \"const fs=require('fs'),path=require('path');const d=path.resolve('src/data/backups');if(!fs.existsSync(d))fs.mkdirSync(d,{recursive:true});const ts=new Date().toISOString().replace(/[:.]/g,'-');fs.copyFileSync('src/data/musicians.json',path.join(d,'musicians-manual-'+ts+'.json'));console.log('Backup created');\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && netlify deploy --prod --dir=dist",
    "server": "node server/server.js",
    "dev:server": "concurrently \"npm run dev\" \"npm run server\"",
    "etl": "node etl-claude-enrich.js",
    "etl:all": "node etl-claude-enrich.js --all",
    "etl:musician": "node etl-claude-enrich.js --musician",
    "enrich": "node enrich-musicians-v3.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@deck.gl/geo-layers": "^9.2.11",
    "@deck.gl/layers": "^9.2.11",
    "@deck.gl/react": "^9.2.11",
    "@supabase/supabase-js": "^2.99.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "d3": "^7.9.0",
    "deck.gl": "^9.2.11",
    "express": "^5.2.1",
    "jotai": "^2.18.1",
    "maplibre-gl": "^5.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-map-gl": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/sharp": "^0.32.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "storybook": "^10.2.19",
    "@storybook/react-vite": "^10.2.19",
    "@chromatic-com/storybook": "^5.0.1",
    "@storybook/addon-vitest": "^10.2.19",
    "@storybook/addon-a11y": "^10.2.19",
    "@storybook/addon-docs": "^10.2.19",
    "@storybook/addon-onboarding": "^10.2.19",
    "eslint-plugin-storybook": "^10.2.19",
    "vitest": "^4.1.0",
    "playwright": "^1.58.2",
    "@vitest/browser-playwright": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0"
  }
}
